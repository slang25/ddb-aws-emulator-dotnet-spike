<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>AwsEmulator</RootNamespace>
    <Description>Runs aws-emulator in-process (a Rust native library) and plugs it into the AWS SDK for .NET as its HTTP transport.</Description>
    <NativeCrateDir>$(MSBuildThisFileDirectory)../../native/aws-emulator-ffi/</NativeCrateDir>
    <NativeLibPath>$(NativeCrateDir)target/release/libaws_emulator_ffi.so</NativeLibPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.Core" />
  </ItemGroup>

  <!--
    Apply native/patches to the aws-emulator submodule, then build the Rust cdylib (cargo is
    incremental, so this is a no-op once built) and ship it next to the managed assembly; it flows
    to every project that references this one. Pass -p:SkipNativeBuild=true to use an
    already-built library.
  -->
  <Target Name="BuildNativeEmulator" BeforeTargets="BeforeBuild" Condition="'$(SkipNativeBuild)' != 'true'">
    <Exec Command="bash ../apply-patches.sh" WorkingDirectory="$(NativeCrateDir)" />
    <Exec Command="cargo build --release" WorkingDirectory="$(NativeCrateDir)" />
  </Target>

  <ItemGroup>
    <None Include="$(NativeLibPath)" Link="libaws_emulator_ffi.so" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
